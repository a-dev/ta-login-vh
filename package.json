{
  "name": "ta-login-vh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run stack:deps && bun run db:setup && bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "db:setup": "bun scripts/db-setup.ts",
    "stack:start": "docker compose up -d",
    "stack:deps": "docker compose stop api && docker compose up -d --wait mysql redis",
    "stack:stop": "docker compose down --remove-orphans",
    "sync:disposable-domains": "bun scripts/sync-disposable-domains.ts",
    "dev:remove-sessions": "docker compose exec redis redis-cli del 'rate-limit:ip:127.0.0.1'"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jose": "^6.0.12",
    "mysql2": "^3.14.4",
    "pino": "^10.3.1",
    "redis": "^6.2.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2"
  }
}
